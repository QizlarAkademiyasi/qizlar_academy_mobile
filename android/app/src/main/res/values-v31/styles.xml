<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ SplashScreen API -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <!-- Pre-Android 12 fallback (and Flutter first-frame background) -->
        <item name="android:windowBackground">@drawable/launch_background</item>

        <!-- Android 12+ SplashScreen API -->
        <!-- Note: background must be a solid color on Android 12+ -->
        <item name="windowSplashScreenBackground">@color/splash_native_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
